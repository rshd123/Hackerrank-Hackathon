# Groq API Key (FREE) — Get from: https://console.groq.com
OPENAI_API_KEY=gsk_your_groq_key_here

# Nvidia NIM API Key (BACKUP — not currently used)
# NVIDIA_NIM_KEY=nvapi_your_nim_key_here

# Base URL — Groq (FREE, fast)
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Groq free models: qwen/qwen3.8-27b, qwen/qwen3.6-27b, openai/gpt-oss-120b
CLASSIFICATION_MODEL=qwen/qwen3.8-27b
RESPONSE_MODEL=qwen/qwen3.8-27b
TEMPERATURE=0.1

# Paths
CORPUS_PATH=knowledge_base
TICKETS_PATH=data/input_tickets.json
OUTPUT_PATH=output/agent_output.csv

# RAG settings
TOP_K=5
RERANK_TOP_K=3
