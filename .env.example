# OpenAI API Key (required for LLM calls)
OPENAI_API_KEY=sk-your-key-here

# Alternative: Anthropic API Key (if using Claude instead)
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model settings
CLASSIFICATION_MODEL=gpt-4o-mini
RESPONSE_MODEL=gpt-4o
TEMPERATURE=0.1

# Paths
CORPUS_PATH=knowledge_base
TICKETS_PATH=data/input_tickets.json
OUTPUT_PATH=output/agent_output.csv

# RAG settings
TOP_K=5
RERANK_TOP_K=3
